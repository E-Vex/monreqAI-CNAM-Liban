# =============================================================================
# monreqAI-CNAM-Liban (C edition) -- sample environment file
# =============================================================================
# Copy to .env and fill in. Never commit the real .env file.
#
# The binary auto-loads .env from the current working directory at startup
# (see src/config.c:config_init). Existing environment variables always win
# over .env entries, so an explicit 'export FOO=bar' in your shell overrides
# anything in .env. You can also skip .env entirely and use your preferred
# secrets manager / systemd EnvironmentFile= / docker -e ... -- same result.
#
# =============================================================================
# AI classification (at least one provider recommended; otherwise the
# keyword fallback is used for every announcement)
# =============================================================================

# Comma-separated Gemini keys. The classifier rotates through them and
# disables any that return 400/401/403/404/429 for the rest of the run.
# A single key is fine.
GEMINI_API_KEYS=""
# Singular form tolerated when the plural is empty (backwards compat).
# GEMINI_API_KEY=""

# Default "gemini-2.5-flash" is the cheapest model that supports
# thinkingConfig.thinkingLevel and responseSchema. Older models (1.5-flash)
# are shut down by Google; if you pin one, the 400 fallback retries once
# without the schema features.
GEMINI_MODEL="gemini-2.5-flash"

# OpenRouter is the second tier, tried only if every Gemini key is dead
# or unparseable.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# =============================================================================
# Telegram (one bot token, one general channel, optional department channels)
# =============================================================================

# Create a bot via @BotFather, paste the token below.
TELEGRAM_BOT_TOKEN=""

# Every new announcement lands here first, unclassified. Required if you
# want any notifications at all.
TELEGRAM_CHANNEL_GENERAL=""

# Per-department channels. Leave blank to skip that department entirely
# (its announcements still go to the general channel; they just don't get
# routed to a department-specific chat).
TELEGRAM_CHANNEL_INFORMATIQUE=""
TELEGRAM_CHANNEL_CIVIL=""
TELEGRAM_CHANNEL_ELECTRIQUE=""
TELEGRAM_CHANNEL_MECANIQUE=""
TELEGRAM_CHANNEL_PROCEDES=""
TELEGRAM_CHANNEL_ECONOMIE=""
TELEGRAM_CHANNEL_STATISTIQUE=""
TELEGRAM_CHANNEL_PHYSIQUE=""
TELEGRAM_CHANNEL_LANGUES=""

# Legacy alias: TELEGRAM_CHANNEL_CS maps to informatique, but only if
# TELEGRAM_CHANNEL_INFORMATIQUE is unset. Kept for backwards compat.
# TELEGRAM_CHANNEL_CS=""

# =============================================================================
# Tuning (all optional; the defaults match the Python reference)
# =============================================================================

# Atom feed URL. The default uses HTTP because annonces.isae.edu.lb has a
# flaky TLS setup; the HTTP client disables TLS verification either way.
# FEED_URL="http://annonces.isae.edu.lb/feeds/posts/default?max-results=25"

# State file path. Relative paths are resolved against the CWD.
# STATE_FILE="seen.json"

# Per-request timeout in seconds. Applies to feed fetch, Gemini, OpenRouter,
# and Telegram calls alike.
# REQUEST_TIMEOUT="20"

# Number of HTTP attempts per request (1 = no retry). Retries only on
# network errors and {408, 425, 429, 500, 502, 503, 504}.
# MAX_RETRIES="3"

# Minimum seconds between two Telegram sends (per-bot throttle). Set to 0
# to disable. Telegram's hard rate limit is ~30 messages/second to
# different chats; 1.2s is a conservative default.
# SEND_INTERVAL="1.2"

# Maximum number of entries kept in seen.json. Older entries (by 't' field)
# are pruned on save. 1000 is generous: the feed caps at 25 entries, so
# in steady state the file has ~25 entries.
# STATE_HISTORY="1000"
