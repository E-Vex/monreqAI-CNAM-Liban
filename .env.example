# Copy to .env and fill in. Never commit the real file.
# Load it with:  set -a; source .env; set +a

# --- AI classification (at least one provider recommended) -------------------
# Comma-separated; the monitor rotates through them and disables dead ones.
GEMINI_API_KEYS=""
GEMINI_MODEL="gemini-2.5-flash"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""

# Every announcement goes here, unclassified.
TELEGRAM_CHANNEL_GENERAL=""

# Per-department channels. Leave blank to skip that department entirely.
TELEGRAM_CHANNEL_INFORMATIQUE=""
TELEGRAM_CHANNEL_CIVIL=""
TELEGRAM_CHANNEL_ELECTRIQUE=""
TELEGRAM_CHANNEL_MECANIQUE=""
TELEGRAM_CHANNEL_PROCEDES=""
TELEGRAM_CHANNEL_ECONOMIE=""
TELEGRAM_CHANNEL_STATISTIQUE=""
TELEGRAM_CHANNEL_PHYSIQUE=""
TELEGRAM_CHANNEL_LANGUES=""

# --- Tuning (all optional) ---------------------------------------------------
# FEED_URL="https://annonces.isae.edu.lb/feeds/posts/default?max-results=25"
# STATE_FILE="seen.json"
# REQUEST_TIMEOUT="20"
# MAX_RETRIES="3"
# SEND_INTERVAL="1.2"
# STATE_HISTORY="1000"
