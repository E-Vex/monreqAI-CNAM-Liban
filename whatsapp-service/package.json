{
  "name": "whatsapp-service",
  "version": "1.0.0",
  "description": "Local sidecar that posts plain-text messages to one WhatsApp Channel via Baileys",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=../.env dist/index.js",
    "dev": "tsx --env-file=../.env src/index.ts",
    "resolve-jid": "tsx src/resolve-jid.ts"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "baileys": "7.0.0-rc14",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
